{
    "editor.fontFamily": "'JetBrainsMono Nerd Font', monospace",
    "editor.fontLigatures": true,
    "editor.detectIndentation": true,
    "editor.guides.bracketPairs": true,
    "editor.inlineSuggest.enabled": true,
    "editor.suggestSelection": "first",
    "editor.formatOnSave": true,
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.minimap.enabled": false,
    "diffEditor.ignoreTrimWhitespace": false,

    "files.autoSave": "onFocusChange",
    "files.eol": "\n",
    "files.exclude": {
        "**/.git": true,
        "**/.svn": true,
        "**/.hg": true,
        "**/CVS": true,
        "**/.DS_Store": true,
        "**/node_modules": true,
        "**/dist": true
    },
    "files.watcherExclude": {
        "**/.git/objects/**": true,
        "**/node_modules/**": true,
        "**/tmp/**": true,
        "**/dist/**": true,
        "**/.bloop": true,
        "**/.metals": true
    },

    "explorer.confirmDelete": false,
    "explorer.fileNesting.patterns": {
        "*.ts": "${capture}.js",
        "*.js": "${capture}.js.map, ${capture}.min.js, ${capture}.d.ts",
        "*.jsx": "${capture}.js",
        "*.tsx": "${capture}.ts",
        "tsconfig.json": "tsconfig.*.json",
        "package.json": "package-lock.json, yarn.lock, pnpm-lock.yaml, bun.lockb, bun.lock",
        "*.sqlite": "${capture}.${extname}-*",
        "*.db": "${capture}.${extname}-*",
        "*.sqlite3": "${capture}.${extname}-*",
        "*.db3": "${capture}.${extname}-*",
        "*.sdb": "${capture}.${extname}-*",
        "*.s3db": "${capture}.${extname}-*"
    },

    "git.mergeEditor": false,
    "git.openRepositoryInParentFolders": "always",

    "terminal.integrated.fontFamily": "'JetBrainsMono Nerd Font'",
    "terminal.integrated.shellIntegration.decorationsEnabled": "never",

    "workbench.colorTheme": "One Dark Pro Flat",
    "workbench.iconTheme": "symbols",
    "workbench.startupEditor": "newUntitledFile",
    "workbench.editor.editorActionsLocation": "hidden",
    "workbench.settings.applyToAllProfiles": [],
    "window.zoomLevel": -1,

    "workbench.colorCustomizations": {
        "[One Dark Pro Flat]": {
            "editor.background": "#1E2128",
            "sideBar.background": "#1E2128",
            "panel.background": "#1E2128",
            "activityBar.background": "#1E2128",
            "titleBar.activeBackground": "#1E2128",
            "tab.activeBackground": "#1E2128",
            "editorGroupHeader.tabsBackground": "#1E2128",
            "terminal.background": "#1E2128",
            "terminal.foreground": "#ABB2BF",
            "terminal.ansiBlack": "#1E2128",
            "terminal.ansiRed": "#E06B74",
            "terminal.ansiGreen": "#98C379",
            "terminal.ansiYellow": "#E5C07A",
            "terminal.ansiBlue": "#62AEEF",
            "terminal.ansiMagenta": "#C778DD",
            "terminal.ansiCyan": "#55B6C2",
            "terminal.ansiWhite": "#ABB2BF",
            "terminal.ansiBrightBlack": "#50545B",
            "terminal.ansiBrightRed": "#EA757E",
            "terminal.ansiBrightGreen": "#A2CD83",
            "terminal.ansiBrightYellow": "#EFCA84",
            "terminal.ansiBrightBlue": "#6CB8F9",
            "terminal.ansiBrightMagenta": "#D282E7",
            "terminal.ansiBrightCyan": "#5FC0CC",
            "terminal.ansiBrightWhite": "#B5BCC9"
        }
    },

    "extensions.ignoreRecommendations": true,
    "chat.commandCenter.enabled": false,
    "github.copilot.enable": {
        "*": false,
        "markdown": false,
        "scminput": false
    },
    "docker.extension.enableComposeLanguageServer": false,

    "[python]": {
        "editor.defaultFormatter": "charliermarsh.ruff"
    },
    "[dockercompose]": {
        "editor.insertSpaces": true,
        "editor.tabSize": 2,
        "editor.autoIndent": "advanced",
        "editor.quickSuggestions": {
            "other": true,
            "comments": false,
            "strings": true
        },
        "editor.defaultFormatter": "redhat.vscode-yaml"
    },
    "[github-actions-workflow]": {
        "editor.defaultFormatter": "redhat.vscode-yaml"
    }
}
